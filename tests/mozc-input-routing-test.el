;;; mozc-input-routing-test.el --- PGTK Mozc input routing -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(setq load-prefer-newer t)
(defconst my/mozc-routing-test-root
  (file-name-directory (directory-file-name
                        (file-name-directory (or load-file-name buffer-file-name)))))
(add-to-list 'load-path (expand-file-name "inits" my/mozc-routing-test-root))
(require 'mozc.init)

(ert-deftest mozc-routing-disables-gtk-only-for-pgtk ()
  (let ((pgtk-use-im-context-on-new-connection t) calls)
    (cl-letf (((symbol-function 'pgtk-use-im-context)
               (lambda (enabled &rest _) (push enabled calls))))
      (let ((window-system 'pgtk))
        (my/mozc-configure-pgtk-input-method))
      (should (equal calls '(nil)))
      (should-not pgtk-use-im-context-on-new-connection)
      (dolist (backend '(nil x ns))
        (let ((window-system backend)
              (pgtk-use-im-context-on-new-connection t))
          (my/mozc-configure-pgtk-input-method)
          (should pgtk-use-im-context-on-new-connection)))
      (should (equal calls '(nil))))))

(ert-deftest mozc-routing-leaves-native-ime-without-mozc ()
  (let ((original-featurep (symbol-function 'featurep))
        (window-system 'pgtk)
        (pgtk-use-im-context-on-new-connection t))
    (cl-letf (((symbol-function 'featurep)
               (lambda (feature &rest args)
                 (and (not (eq feature 'mozc))
                      (apply original-featurep feature args))))
              ((symbol-function 'pgtk-use-im-context)
               (lambda (&rest _) (ert-fail "Unexpected GTK input change"))))
      (my/mozc-configure-pgtk-input-method)
      (should pgtk-use-im-context-on-new-connection))))

(ert-deftest mozc-routing-registers-new-frame-handler ()
  (should (memq #'my/mozc-configure-pgtk-input-method after-make-frame-functions)))

(ert-deftest mozc-routing-can-select-native-gtk-input ()
  (let ((my/pgtk-use-native-ime t)
        (window-system 'pgtk)
        (pgtk-use-im-context-on-new-connection nil)
        calls)
    (cl-letf (((symbol-function 'pgtk-use-im-context)
               (lambda (enabled &rest _) (push enabled calls))))
      (my/mozc-configure-pgtk-input-method)
      (should (equal calls '(t)))
      (should pgtk-use-im-context-on-new-connection))))

(ert-deftest mozc-routing-control-keys-reach-mozc ()
  (with-temp-buffer
    (let ((mozc-mode t)
          (minor-mode-map-alist (cons (cons 'mozc-mode mozc-mode-map)
                                      minor-mode-map-alist))
          sent)
      (dolist (key '("C-k" "C-j"))
        (should (eq (key-binding (kbd key) t) 'mozc-handle-event)))
      (cl-letf (((symbol-function 'mozc-session-sendkey)
                 (lambda (event) (push event sent))))
        (mozc-send-key-event (aref (kbd "C-k") 0))
        (mozc-send-key-event (aref (kbd "C-j") 0)))
      (should (equal (reverse sent) '((107 control) (106 control)))))))
